{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "메인 창이 쓸 수 있는 것들",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "fs:default",
    "fs:allow-appdata-write-recursive",
    "fs:allow-appdata-read-recursive",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://192.168.4.1/*" },
        { "url": "http://*.local/*" },
        { "url": "http://192.168.*.*/*" },
        { "url": "http://10.*.*.*/*" },
        { "url": "http://172.16.*.*/*" }
      ]
    }
  ]
}
